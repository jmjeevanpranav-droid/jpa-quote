      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/quotations/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/quotations/[id].segments/quotations/$d$id$segment",
          "source": "^/quotations/(?<nxtPid>[^/]+?)\\.segments/quotations/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    },
    {
      "page": "/quotations/[id]/edit",
      "regex": "^/quotations/([^/]+?)/edit(?:/)?$",
