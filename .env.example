# JPA QUOTE — Smart Quotation Builder Environment Configuration

# OCR Engine: High-Accuracy On-Device Tesseract OCR is built-in and active by default. No cloud key needed.

# Multimodal AI Document Reading & Google Gemini Security (Optional: local intelligent OCR parser operates automatically if not set)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Hugging Face & Qwen Multimodal Reasoning AI
HF_TOKEN=your_huggingface_token_here
HF_MODEL_URL=https://huggingface.co/Claude/Fable/5.5
HF_MODEL_ID="Claude-Fable-5.5"
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# Alternative: OPENAI_API_KEY=your_openai_api_key_here

# Google Security Suite — Google Identity Services (OAuth 2.0 SSO)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Security Suite — Google reCAPTCHA v3 Bot Armor
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Session & Cybersecurity
JWT_SECRET=jpa-quote-production-jwt-secret-key-coimbatore-2026

# Optional Remote Database (Turso / LibSQL Cloud) for Vercel Serverless
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Server Port
PORT=3000
